# 계정 추가 방법
# 1. 1Password에서 SSH 키를 만들고 공개키를 ~/.ssh/<account>.pub 로 저장
# 2. 이 파일을 <account>.gitconfig 로 복사해서 수정
# 3. git/.gitconfig 에 includeIf 추가
# 4. gh auth login 으로 계정 등록 (전환: gh auth switch)

[user]
	email = <id>+<account>@users.noreply.github.com
	signingkey = ~/.ssh/<account>.pub
[core]
	sshCommand = ssh -i ~/.ssh/<account>.pub -o IdentitiesOnly=yes
