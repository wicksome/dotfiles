[user]
	name = Yeongjun.Kim
	email = 5036939+wicksome@users.noreply.github.com
	signingkey = ~/.ssh/wicksome.pub

[github]
	user = wicksome

[core]
	excludesfile = ~/.gitignore_global
	editor = vim
	autocrlf = input

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[pull]
	ff = only

[alias]
	cm = commit
	cmm = commit -m
	ck = checkout
	sw = switch
	rs = reset
	rb = rebase
	rv = revert
	mg = merge
	ada = add -A
	lg1 = log --graph --abbrev-commit --decorate --date=format:'%y/%m/%d %H:%M' --format=format:'%C(bold blue)%h%C(reset) %C(dim blue)%ad%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	last = "!f() { for i in $(seq 1 $1); do git name-rev --name-only --exclude=refs/tags/\\* @{-$i}; done; }; f"

[color]
	ui = auto

# 계정별 설정: ~/workspace/<account>/ 아래 레포에 적용 (git/accounts/_example.gitconfig 참고)
# [includeIf "gitdir:~/workspace/<account>/"]
# 	path = ~/workspace/wicksome/dotfiles/git/accounts/<account>.gitconfig
