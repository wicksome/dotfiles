[user]
	name = Yeongjun.Kim
	email = 5036939+wicksome@users.noreply.github.com
	signingkey = ~/.ssh/wicksome.pub

[github]
	user = wicksome

[core]
	excludesfile = ~/.gitignore_global
	editor = vim
	autocrlf = input

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[pull]
	ff = only

[alias]
	cm = commit
	cmm = commit -m
	ck = checkout
	sw = switch
	rs = reset
	rb = rebase
	rv = revert
	mg = merge
	ada = add -A
	lg1 = log --graph --abbrev-commit --decorate --date=format:'%y/%m/%d %H:%M' --format=format:'%C(bold blue)%h%C(reset) %C(dim blue)%ad%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	last = "!f() { for i in $(seq 1 $1); do git name-rev --name-only --exclude=refs/tags/\\* @{-$i}; done; }; f"

[color]
	ui = auto

# 비공개 설정 (dotfiles-private)
[include]
	path = ~/.gitconfig.local

# 머신 전용 설정 (있을 때만, 심링크 아님). 가장 나중에 읽어 위 설정을 덮어쓴다.
[include]
	path = ~/.gitconfig.machine
