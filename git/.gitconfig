# identity(name·email)는 비공개 층이 정한다. 여기는 이 레포 install.sh 가 만드는 서명 키 경로만 둔다
[user]
	signingkey = ~/.ssh/id_ed25519.pub

[core]
	excludesfile = ~/.gitignore_global
	editor = vim
	autocrlf = input

[gpg]
	format = ssh

# 서명은 ssh-keygen(기본). 머신마다 다르게 하려면 ~/.gitconfig.machine 에서 덮어쓴다
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[pull]
	ff = only

[help]
	autocorrect = prompt

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[column]
	ui = auto

[alias]
	cm = commit
	cmm = commit -m
	ck = checkout
	sw = switch
	rs = reset
	rb = rebase
	rv = revert
	mg = merge
	ada = add -A
	out = log @{u}..
	lgn = log --graph --abbrev-commit --decorate --date=format:'%y/%m/%d %H:%M' --format=format:'%C(bold blue)%h%C(reset) %C(dim blue)%ad%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
	lg1 = log --graph --abbrev-commit --decorate --date=format:'%y/%m/%d %H:%M' --format=format:'%C(bold blue)%h%C(reset) %C(dim blue)%ad%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	last = "!f() { for i in $(seq 1 $1); do git name-rev --name-only --exclude=refs/tags/\\* @{-$i}; done; }; f"

[color]
	ui = auto

# 비공개 설정 (dotfiles-private)
[include]
	path = ~/.gitconfig.local

# 머신 전용 설정 (있을 때만, 심링크 아님). 가장 나중에 읽어 위 설정을 덮어쓴다.
[include]
	path = ~/.gitconfig.machine
