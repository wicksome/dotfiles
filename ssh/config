# 개인 키는 1Password에만 있고, ssh는 1Password SSH Agent에 서명을 요청한다.
Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# 기본 계정(wicksome). 다른 계정은 git/accounts/의 core.sshCommand로 덮어쓴다.
# 공개키(.pub)로 1Password 안의 키를 지정한다. 없으면 agent의 키를 순서대로 시도해 엉뚱한 계정으로 인증될 수 있다.
Host github.com
    IdentityFile ~/.ssh/wicksome.pub
    IdentitiesOnly yes
